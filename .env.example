DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

WAKE_WORD=señor gabriel

# Transcripción local (faster-whisper)
WHISPER_MODEL=small
# Modelo usado para re-transcribir SOLO las consultas de música (mejor
# precisión en títulos de canciones). Vacío = deshabilitado.
MUSIC_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
# Frase de ejemplo que inclina a whisper hacia los comandos del bot.
WHISPER_INITIAL_PROMPT=Señor Gabriel, muteá a, desmutear, silenciar, sordear, desordear, mover a, reproducir música, tocar, poné, decir, hablá, escríbime, expulsar, banear, ayuda.
NO_SPEECH_THRESHOLD=-1.0
NO_SPEECH_PROB_THRESHOLD=0.6
# 1 = más rápido pero menos preciso; 5 = default de whisper.
BEAM_SIZE=5

# Latencia de las acciones por voz
# Silencio (s) tras dejar de hablar para considerar terminado el segmento.
# Más bajo = respuesta más rápida, pero puede partir frases con pausas largas.
SILENCE_DURATION=2.0
# Cada cuántos segundos se transcriben los segmentos pendientes.
DRAIN_INTERVAL=1.0

SAVE_SEGMENTS=0
SEGMENTS_DIR=segments
# Los WAVs de segmentos más viejos que esto (horas) se borran solos. 168 = 7 días.
SEGMENTS_MAX_AGE_HOURS=168

# TTS (edge-tts)
TTS_VOICE=es-AR-ElenaNeural
TTS_RATE=+0%

IGNORE_BOT_AUDIO=1

# Música
MUSIC_VOLUME=0.5
YDL_SLEEP_REQUESTS=0.5
